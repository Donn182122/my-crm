CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8081/'
app.indexPage = ''
app.appTimezone = 'Asia/Manila'
database.default.hostname = 127.0.0.1
database.default.database = my_crm_db
database.default.username = my_crm_app
database.default.password = 'SET_A_UNIQUE_LOCAL_PASSWORD'
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.strictOn = true
encryption.key = 'GENERATE_WITH_SPARK_KEY_GENERATE'
